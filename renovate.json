{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests", ":pinDevDependencies"],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Major updates wait for a maintainer to approve them on the dependency dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": ["security"]
  }
}
