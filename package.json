{
  "name": "sapi-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "A local, single-user gateway that lets any OpenAI- or Anthropic-compatible SDK use your own Claude and ChatGPT subscriptions.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sapi": "src/cli.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run lint && bun run typecheck && bun test",
    "ari42": "python3 .agents/skills/ari42/scripts/ari42_scan.py verify . --report",
    "build:linux-x64": "bun build src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-linux-x64 --outfile dist/sapi-linux-x64",
    "build:linux-arm64": "bun build src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-linux-arm64 --outfile dist/sapi-linux-arm64",
    "build:darwin-arm64": "bun build src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-darwin-arm64 --outfile dist/sapi-darwin-arm64",
    "build:darwin-x64": "bun build src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --target=bun-darwin-x64 --outfile dist/sapi-darwin-x64"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "1.4.5",
    "openai": "7.61.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
